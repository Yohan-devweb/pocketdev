{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pocketdev-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "pocketdev", "migrations_dir": "migrations" }],
  // En production : l'app installée (pocketdev://) et Expo Go sur iPhone (exp://). En local, voir .dev.vars.example.
  "vars": { "APP_REDIRECT_PREFIXES": "pocketdev://,exp://" },
  // Un conteneur éphémère par tâche : c'est le « runner ».
  "containers": [
    {
      "class_name": "WorkspaceContainer",
      "scheduling_policy": "durable_object",
      "images": { "workspace": { "dockerfile": "./container/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceContainer"] }]
}
